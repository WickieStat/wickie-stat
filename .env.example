# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.
# All of these are SERVER-ONLY. Never prefix them with NEXT_PUBLIC_.

# ── AI assistant (optional — without it the chatbot runs in labelled demo mode)
OPENAI_API_KEY=
# Any chat model that supports JSON-schema structured output. Check OpenAI's model list for the current recommendation.
OPENAI_MODEL=gpt-4o-mini

# ── Enquiry delivery (configure at least ONE of these, ideally both)
# 1) Email via Resend — https://resend.com (free tier available)
RESEND_API_KEY=
# Where enquiries go (defaults to wickiestat97@gmail.com)
ENQUIRY_TO_EMAIL=wickiestat97@gmail.com
# Must be a sender on a domain you've verified in Resend, e.g. "Wickie Stat <enquiries@wickiestat.com>".
# Until you verify a domain, onboarding@resend.dev only delivers to the email you signed up to Resend with.
ENQUIRY_FROM_EMAIL=Wickie Stat Website <onboarding@resend.dev>

# 2) Database via Supabase — https://supabase.com (run supabase/schema.sql first)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
